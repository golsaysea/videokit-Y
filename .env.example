# VideoKit / pyMediaTools 环境变量模板
# 复制为 .env 后填入对应配置（.env 已在 .gitignore 中被忽略，切勿提交真实密钥）

# 运行与调试配置
VITE_PORT=5173
FLASK_DEBUG=false
VIDEOKIT_ALLOW_MULTI_INSTANCE=0

# 可选：自定义外部工具二进制路径
# FFMPEG_PATH=
# FFPROBE_PATH=
# YTDLP_PATH=
# EDGE_TTS_PYTHON=

# 可选：自动更新配置
# VIDEOKIT_UPDATE_FEED_URL=
# VIDEOKIT_DISABLE_AUTO_UPDATE=0
# GH_TOKEN=
